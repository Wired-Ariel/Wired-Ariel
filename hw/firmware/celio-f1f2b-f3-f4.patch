+/* F-3: 0 = auto, 1 = forza cablaggio GBA (SD su GP3), 2 = forza GBC (SD su GP4).
+ * Sticky: link_detectCableType() lo rispetta invece di sovrascriverlo. */
+static int g_cable_override = 0;
+
+void link_setCableType(int type)
+{
+    g_cable_override = type;
+    if (type == 1) g_gbc_cable = false;
+    else if (type == 2) g_gbc_cable = true;
+    else g_gbc_cable = detect_gbc_cable();
+}
+
 void link_detectCableType(void)
 {
+    if (g_cable_override == 1) { g_gbc_cable = false; return; }
+    if (g_cable_override == 2) { g_gbc_cable = true;  return; }
     g_gbc_cable = detect_gbc_cable();
 }
 
